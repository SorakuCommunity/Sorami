# === Required ===

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/sorami

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Server
PORT=4000
# Comma-separated origins allowed for CORS (frontend URL)
CORS_ORIGIN=http://localhost:3000

# JWT secret (generate with: openssl rand -hex 32)
JWT_SECRET=change-this-to-a-random-secret

# === Optional ===

# TMDB API key (for metadata enrichment)
# TMDB_API_KEY=your_tmdb_api_key

# Consumet API URL
# CONSUMET_API_URL=https://kuroji-api-j4mh.onrender.com

# ApiStreams backend
# API_STREAMS_BASE_URL=https://apistreams.vercel.app

# Default subtitle language: id = Indonesian, en = English
DEFAULT_SUBTITLE_LANG=id

# Queue/Worker (BullMQ with Redis)
# BULL_REDIS_PREFIX={sorami}
# WORKER_CONCURRENCY=5

# Cloudflare R2 (file uploads)
# CLOUDFLARE_R2_ACCESS_KEY=
# CLOUDFLARE_R2_SECRET_KEY=
# CLOUDFLARE_R2_BUCKET=
# CLOUDFLARE_R2_PUBLIC_URL=

# Monitoring
# SENTRY_DSN=

# Admin
# ADMIN_API_KEY=
