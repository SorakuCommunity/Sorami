# ===============================================
# SORAKU ENVIRONMENTS VARIABLES
# ===============================================

# ===============================================
# REQUIRED VARIABLES
# ===============================================

# Supabase (Required) - Get from your Supabase project
# https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Database (Required) - PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@your-host:6543/postgres

# Upstash Redis (Required) - For caching
# https://upstash.com
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ===============================================
# OPTIONAL VARIABLES
# ===============================================

# Consumet API - Override default if needed
# Default: https://api.consumet.org
# You can deploy your own at https://github.com/consumet/consumet
CONSUMET_API_URL=https://api.consumet.org

# Public API Base URL (Optional)
NEXT_PUBLIC_API_BASE_URL=https://api.consumet.org