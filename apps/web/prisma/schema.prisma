generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  username      String         @unique
  avatar        String?
  provider      String         @default("email")
  role          UserRole       @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  favorites     Favorite[]
  watchHistory  WatchHistory[]
  roomsHosted   Room[]         @relation("HostRooms")
  roomsJoined   RoomMember[]
}

enum UserRole {
  USER
  ADMIN
}

model Anime {
  id            String       @id @default(cuid())
  title         String
  titleEnglish  String?
  titleNative   String?
  slug          String       @unique
  poster        String
  banner        String?
  description   String?      @db.Text
  rating        Float?
  status        AnimeStatus
  releaseDate   String?
  year          Int?
  duration      String?
  episodesCount Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  episodes      Episode[]
  genres        AnimeGenre[]
  favorites     Favorite[]
  watchHistory  WatchHistory[]
}

enum AnimeStatus {
  ONGOING
  COMPLETED
  UPCOMING
}

model Genre {
  id     String       @id @default(cuid())
  name   String       @unique
  slug   String       @unique
  anime  AnimeGenre[]
}

model AnimeGenre {
  animeId String
  genreId String
  anime   Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)
  genre   Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([animeId, genreId])
}

model Episode {
  id           String   @id @default(cuid())
  animeId      String
  number       Int
  title        String?
  description  String?
  videoUrl     String?
  thumbnail    String?
  duration     Int?
  releasedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  anime        Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([animeId, number])
}

model Favorite {
  id          String   @id @default(cuid())
  userId      String
  animeId     String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime       Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
}

model WatchHistory {
  id           String    @id @default(cuid())
  userId       String
  animeId      String
  episode      Int
  progress     Float     @default(0)
  totalSeconds Float     @default(0)
  completed    Boolean   @default(false)
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime        Anime      @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId, episode])
}

model Room {
  id            String       @id @default(cuid())
  animeId       String
  animeTitle    String
  episode       Int          @default(1)
  status        RoomStatus   @default(WAITING)
  currentTime   Float        @default(0)
  hostId        String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  host          User         @relation("HostRooms", fields: [hostId], references: [id], onDelete: Cascade)
  members       RoomMember[]
}

model RoomMember {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  joinedAt  DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

enum RoomStatus {
  WAITING
  PLAYING
  PAUSED
}